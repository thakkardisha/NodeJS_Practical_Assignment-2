<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Published Blog Posts</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #f4f4f4;
            margin: 0;
            padding: 30px;
        }

        h1 {
            text-align: center;
        }

        .posts-container {
            max-width: 800px;
            margin: 30px auto;
        }

        .post {
            background: white;
            padding: 20px;
            margin-bottom: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.1);
        }

        .post h2 {
            margin-top: 0;
        }

        .post img {
            max-width: 100%;
            max-height: 300px;
            display: block;
            margin: 15px 0;
            border-radius: 6px;
        }

        .tags {
            color: #555;
        }

        .empty {
            text-align: center;
            color: #777;
        }
    </style>
</head>

<body>

    <h1>Published Blog Posts</h1>

    <div class="posts-container">

        <% if (posts.length === 0) { %>

            <p class="empty">
                No published posts available.
            </p>

        <% } else { %>

            <% posts.forEach(post => { %>

                <div class="post">

                    <h2>
                        <%= post.title %>
                    </h2>

                    <% if (post.featuredImage) { %>

                        <img
                            src="<%= post.featuredImage %>"
                            alt="Featured Image"
                        >

                    <% } %>

                    <p>
                        <%= post.content %>
                    </p>

                    <% if (post.tags && post.tags.length > 0) { %>

                        <p class="tags">
                            <strong>Tags:</strong>
                            <%= post.tags.join(", ") %>
                        </p>

                    <% } %>

                </div>

            <% }); %>

        <% } %>

    </div>

</body>

</html>